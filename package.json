{
  "name": "dsh-plugin-sidebar-categories",
  "version": "0.1.0",
  "description": "将左侧导航按工作、管理、开发分类，支持自行归类。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}